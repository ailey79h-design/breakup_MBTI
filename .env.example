# === API Multi-Connector Dashboard ===
# 이 파일을 .env.local로 복사한 뒤 실제 키를 입력하세요.

YOUTUBE_API_KEY=
# 공공데이터포털(data.go.kr) 기상청_단기예보 조회서비스 인증키
WEATHER_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/callback/gmail
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 카카오 (결과 공유 — Kakao JavaScript 키, 웹 도메인 등록 필요)
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 로컬: .env.local 에 동일 이름으로 저장 → npm run dev
# Vercel: Project → Settings → Environment Variables → KAKAO_JAVASCRIPT_KEY 추가 후 Redeploy
# 카카오 콘솔 필수 (공유 링크 클릭 시 apps.kakao.com 으로 가면 미등록):
# 1) [앱] > [플랫폼] > Web > 사이트 도메인: https://breakup-mbti.vercel.app , http://localhost:3000
# 2) [앱] > [제품 링크 관리] > 웹 도메인: https://breakup-mbti.vercel.app  ← 없으면 수신 설정 페이지만 뜸
# 3) [앱] > [플랫폼 키] > JavaScript 키 > JavaScript SDK 도메인: 위와 동일
KAKAO_JAVASCRIPT_KEY=

# Supabase (근처 탐색 / explore — https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (API route, RLS 우회 필요 시만 — Vercel에만 설정)
SUPABASE_SERVICE_ROLE_KEY=
# DB 마이그레이션 (npm run db:patch) — Dashboard > Settings > Database > password
# SUPABASE_DB_PASSWORD=
# 또는 Account > Access Tokens
# SUPABASE_ACCESS_TOKEN=
